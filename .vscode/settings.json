{
  "files.associations": {
    ".yamlfmt": "yaml"
  },
  "files.exclude": {
    "_*": false,
    ".chatledger": true,
    ".goreleaser.yaml": false,
    ".yamlfmt": false,
    ".vscode": false,
    "vendor": true,
    "_artifacts": false,
    "_antigravity": false,
    ".specstory": true,
    "dist": false,
    ".devcontainer": true,
    "coverage.out": true,
    "coverage": true
  },
  "explorer.excludeGitIgnore": false,
  "chatledger.exportDirectory": ".chatledger",
  "chatledger.enabled": true,
  "makefile.configureOnOpen": false,
  "cSpell.words": [
    "golangci"
  ],
  "languageToolLinter.languageTool.disabledRules": "ARROWS,UNLIKELY_OPENING_PUNCTUATION,WHITESPACE_RULE"
}
